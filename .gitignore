# =========== NISMA .gitignore ===========

# === Fichiers de version (archives) ===
Nisma_Archive_*

# === Build outputs ===
# Dossiers de build
bin/
obj/
build/
dist/
publish/

# Fichiers de build temporaires
*.o
*.a
*.obj
*.pdb
*.dll
*.exe
*.runtimeconfig.json
*.deps.json
*.log

# Fichiers de cache
*.cache
*.nuget
*.userosscache
*.sln.docstates
*.ojb
*.user

# Fichiers temporaires créés par le build
core.*

# === Fichiers de IDE ===
.idea/
*.iml
.vscode/
*.sublime-project
*.sublime-workspace

# === Fichiers de test/JUnit ===
TEST-*.xml
TEST-*.html
.testcafe*

# === Exceptions ===
# Ne pas ignorer les fichiers .cs, .vb, .fs, .ps1, .sh, .py, .md, .txt, .json, .xml, .yaml, .yml
# Ces fichiers sont généralement du code source ou des données
!*.cs
!*.vb
!*.fs
!*.ps1
!*.sh
!*.py
!*.md
!*.txt
!*.json
!*.xml
!*.yaml
!*.yml
