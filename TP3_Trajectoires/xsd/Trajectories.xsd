<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema"
        targetNamespace="http://www.univ-grenoble-alpes.fr/trajSim"
        xmlns:traj="http://www.univ-grenoble-alpes.fr/trajSim"
        elementFormDefault="qualified">
    
    <!-- import -->
    <include schemaLocation="Coordinate.xsd"/>
    
    <!-- element racine -->
    <element name="trajectories" type="traj:TrajectoriesType"/>
    
    <!--trajectory: list of positions, trajectories: list of trajectorytypes -->
    <complexType name="TrajectoryType">
        <sequence>
            <element name="pos" type="traj:Coordinate" maxOccurs="unbounded"/>
        </sequence>
        <attribute name="id" type="nonNegativeInteger" use="required"/>
    </complexType>
    
    <complexType name="TrajectoriesType">
        <sequence>
            <element name="trajectory" type="traj:TrajectoryType" maxOccurs="unbounded"/>
        </sequence>
    </complexType>
    
    
    
</schema>